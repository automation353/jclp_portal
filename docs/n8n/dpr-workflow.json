      },
      "id": "f6312490-fd3f-486c-a25a-53e97a4ad419",
      "name": "Extract From File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        720,
        928
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst cleanedRows = [];\n\nfor (const item of rows) {\n  const row = item.json || {};\n\n  const hasAnyValue = Object.values(row).some(value => {\n    if (value === null || value === undefined) return false;\n    return String(value).trim() !== '';\n  });\n\n  if (!hasAnyValue) continue;\n\n  const cleanedRow = {};\n\n  for (const [key, value] of Object.entries(row)) {\n    const cleanKey = String(key || '')\n      .replace(/\\r/g, ' ')\n      .replace(/\\n/g, ' ')\n      .replace(/\\s+/g, ' ')\n      .trim();\n\n    if (!cleanKey) continue;\n    cleanedRow[cleanKey] = value;\n  }\n\n  cleanedRows.push(cleanedRow);\n}\n\nif (cleanedRows.length === 0) {\n  throw new Error('No usable data rows were extracted from the uploaded file.');\n}\n\nreturn [\n  {\n    json: {\n      rowCount: cleanedRows.length,\n      rows: cleanedRows\n    }\n  }\n];"
      },
      "id": "e5bea7f5-b820-497a-bd6b-04b2bc7c95a6",
      "name": "Bundle Rows (collapse to 1 item)",
