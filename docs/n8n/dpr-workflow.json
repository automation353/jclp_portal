    {
      "parameters": {
        "jsCode": "const source = $('Bundle Rows (collapse to 1 item)').first().json;\nconst rows = source.rows || [];\n\nif (!Array.isArray(rows) || rows.length === 0) {\n  throw new Error('No bundled rows available for append.');\n}\n\nreturn rows.map(row => ({ json: row }));"
      },
