      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1540, 700],
      "credentials": { "googleSheetsOAuth2Api": { "id": "PASTE_CREDENTIAL_ID", "name": "Google Sheets Account" } }
    },

    {
      "parameters": {
        "jsCode": "// ── Scorecard Sections branch ──\nconst body = $input.first().json.body || $input.first().json;\nconst sections = (body.sections || {}).rows || [];\nif (!sections.length) return [];\nreturn [{ json: { rows: sections } }];\n"
      },
      "id": "extract-sections",
      "name": "Extract Scorecard Sections",
      "type": "n8n-nodes-base.code",
