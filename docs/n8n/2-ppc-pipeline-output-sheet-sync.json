      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1020, 950],
      "credentials": { "googleSheetsOAuth2Api": { "id": "PASTE_CREDENTIAL_ID", "name": "Google Sheets Account" } }
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Extract Scorecard Sections').first().json.rows || [];\nif (!rows.length) return [];\nreturn rows.map(r => ({ json: r }));\n"
      },
      "id": "split-sections",
