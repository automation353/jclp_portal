  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "IF BOM or Scorecard", "type": "main", "index": 0 }]]
    },
    "IF BOM or Scorecard": {
      "main": [
        [
          { "node": "Extract BOM Components",     "type": "main", "index": 0 },
          { "node": "Extract Shortages",           "type": "main", "index": 0 }
        ],
        [
          { "node": "Extract Scorecard Overall",   "type": "main", "index": 0 },
          { "node": "Extract Scorecard Sections",  "type": "main", "index": 0 }
        ]
      ]
    },

    "Extract BOM Components":     { "main": [[{ "node": "Clear BOM Components",     "type": "main", "index": 0 }]] },
    "Clear BOM Components":       { "main": [[{ "node": "Split BOM Rows",           "type": "main", "index": 0 }]] },
    "Split BOM Rows":             { "main": [[{ "node": "Write BOM Components",     "type": "main", "index": 0 }]] },

    "Extract Shortages":          { "main": [[{ "node": "Clear Shortages",          "type": "main", "index": 0 }]] },
    "Clear Shortages":            { "main": [[{ "node": "Split Shortage Rows",      "type": "main", "index": 0 }]] },
    "Split Shortage Rows":        { "main": [[{ "node": "Write Shortages",          "type": "main", "index": 0 }]] },

    "Extract Scorecard Overall":  { "main": [[{ "node": "Clear Scorecard Overall",  "type": "main", "index": 0 }]] },
    "Clear Scorecard Overall":    { "main": [[{ "node": "Split Overall Rows",       "type": "main", "index": 0 }]] },
    "Split Overall Rows":         { "main": [[{ "node": "Write Scorecard Overall",  "type": "main", "index": 0 }]] },

    "Extract Scorecard Sections": { "main": [[{ "node": "Clear Scorecard Sections", "type": "main", "index": 0 }]] },
    "Clear Scorecard Sections":   { "main": [[{ "node": "Split Section Rows",       "type": "main", "index": 0 }]] },
    "Split Section Rows":         { "main": [[{ "node": "Write Scorecard Sections", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "PPC Pipeline" }, { "name": "Sheet Sync" }],
  "meta": { "instanceId": "jollyclamps" },
  "pinData": {},
  "_comment": "POST /webhook/ppc-pipeline-output — IF routes by payload type. BOM requests → 2 independent flows (BOM Components + Shortages). Scorecard requests → 2 independent flows (Overall + Sections). Each flow only touches its own tab. Replace PASTE_PPC_PIPELINE_SHEET_ID and PASTE_CREDENTIAL_ID."
