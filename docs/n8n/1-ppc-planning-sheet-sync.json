    },
    {
      "parameters": {
        "jsCode": "// Read rows from the Extract node (Clear node doesn't carry them forward)\nconst rows = $('Extract CP Req').first().json.rows || [];\nif (!rows.length) return [];\nreturn rows.map(r => ({ json: r }));\n"
      },
