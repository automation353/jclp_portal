      "webhookId": "sop-dpr"
    },
    {
      "parameters": {
        "jsCode": "// Parse the S&OP upload payload from Django.\n// Supports chunked uploads for large files:\n//   action='replace' (chunk 0): clear tab then append\n//   action='append'  (chunk 1+): append only (no clear)\n\nconst input = $input.first().json;\nconst tabName = input.tab_name || 'DPR';\nconst headers = input.headers || [];\nconst rows    = input.rows || [];\nconst meta    = input._meta || {};\nconst action  = input.action || 'replace';\n\nif (!rows.length) {\n  throw new Error('No rows in payload for DPR');\n}\n\nreturn [{\n  json: {\n    tab_name: tabName,\n    report_key: input.report_key || 'sop_dpr',\n    headers: headers,\n    rows: rows,\n    row_count: rows.length,\n    action: action,\n    chunk_index: input.chunk_index || 0,\n    total_chunks: input.total_chunks || 1,\n    total_rows: input.total_rows || rows.length,\n    uploaded_by: meta.uploader || 'unknown',\n    uploaded_at: meta.uploaded_at || new Date().toISOString(),\n    original_file: meta.original_filename || '',\n  }\n}];"
      },
      "id": "sop-dpr-0002",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.action }}",
              "rightValue": "replace",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "sop-dpr-0010",
      "name": "Is First Chunk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        500
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "clear",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1SQvf65FVUVoXhQasSW9yHBjQWyy_d5cv_7H5TH9l_kc"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "DPR"
        }
