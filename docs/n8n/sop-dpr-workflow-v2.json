    {
      "parameters": {
        "jsCode": "// Log summary\nconst data = $('Parse Payload').first().json;\nconst appended = $input.all().length;\nreturn [{ json: {\n  status: 'done',\n  tab: 'DPR',\n  report_key: data.report_key,\n  action: data.action,\n  chunk: data.chunk_index + '/' + data.total_chunks,\n  rows_written: appended,\n  total_rows: data.total_rows,\n  uploaded_by: data.uploaded_by,\n  original_file: data.original_file,\n}}];"
      },
