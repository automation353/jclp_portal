        "responseMode": "onReceived",
        "responseCode": 200,
        "responseData": "={{ { \"status\": \"accepted\", \"tab\": \"DPR\", \"rows\": $json.row_count, \"chunk\": $json.chunk_index, \"action\": $json.action } }}",
        "options": {
