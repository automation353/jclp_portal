      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "cTdqRAEN5iDJTYQk",
          "name": "Google Sheets \u2014 JCPL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Expand rows array into individual n8n items.\nconst data = $('Parse Payload').first().json;\nconst rows = data.rows || [];\nconst headers = data.headers || [];\nif (!rows.length) return [];\nreturn rows.map(row => {\n  const ordered = {};\n  if (headers.length > 0) {\n    for (const h of headers) {\n      ordered[h] = row[h] !== undefined ? row[h] : '';\n    }\n  } else {\n    Object.assign(ordered, row);\n  }\n  return { json: ordered };\n});"
      },
      "id": "sop-dpr-0004",
      "name": "Expand Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        500
      ]
    },
