{
  "name": "MPS Demand Upload (Material Planning Purchase) -> Google Sheet",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mps-demand",
        "responseMode": "onReceived",
        "responseCode": 200,
        "responseData": "={{ { \"status\": \"accepted\", \"message\": \"MPS Demand upload received. mps_demand tab is refreshing.\" } }}",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "mps0-0000-4000-8000-000000000001",
      "name": "Webhook (MPS Demand)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        400,
        400
      ],
      "webhookId": "mps-demand"
    },
    {
      "parameters": {
        "operation": "xlsx",
        "binaryPropertyName": "file",
        "options": {
          "sheetName": "RM QTY",
          "range": "B2:F2000",
          "headerRow": true,
          "includeEmptyCells": false
        }
      },
      "id": "mps0-0000-4000-8000-000000000002",
      "name": "Extract RM QTY Sheet",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        640,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep only Item Code (renamed to Tally Code) and Total RM.\n// Source (RM QTY sheet) columns: Item Code | Description | Qty for IP | Qty for CP | Total RM\n\nconst rows = $input.all();\nconst out = [];\n\nfor (const item of rows) {\n  const r = item.json || {};\n  const tally = r['Item Code'] ?? r['Tally Code'] ?? '';\n  const total = r['Total RM'] ?? 0;\n  if (tally === '' || tally === null || tally === undefined) continue;\n  out.push({ 'Tally Code': tally, 'Total RM': total });\n}\n\nif (out.length === 0) {\n  throw new Error('No usable rows from RM QTY sheet. Check that the sheet name is \"RM QTY\" and its header row is at row 2.');\n}\n\nreturn [{ json: { rowCount: out.length, rows: out } }];"
      },
      "id": "mps0-0000-4000-8000-000000000003",
      "name": "Bundle MPS Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        400
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "clear",
        "documentId": {
          "__rl": true,
          "value": "1euJuqvIv7wHvwPejgCMOztJNGwU0eyTvPUioYLZZ4fg",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "mps_demand",
          "mode": "name"
        }
      },
      "id": "mps0-0000-4000-8000-000000000004",
      "name": "Clear mps_demand Tab",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1120,
        400
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "cTdqRAEN5iDJTYQk",
          "name": "Google Sheets OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Bundle MPS Rows').first().json;\nconst rows = source.rows || [];\nif (!Array.isArray(rows) || rows.length === 0) throw new Error('No bundled rows for mps_demand.');\nreturn rows.map(row => ({ json: row }));"
      },
      "id": "mps0-0000-4000-8000-000000000005",
      "name": "Expand mps_demand Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        400
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1euJuqvIv7wHvwPejgCMOztJNGwU0eyTvPUioYLZZ4fg",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "mps_demand",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "useAppend": true
        }
      },
      "id": "mps0-0000-4000-8000-000000000006",
      "name": "Write mps_demand Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1600,
        400
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "cTdqRAEN5iDJTYQk",
          "name": "Google Sheets OAuth2 API"
        }
      }
    }
  ],
  "connections": {
    "Webhook (MPS Demand)": { "main": [[{ "node": "Extract RM QTY Sheet", "type": "main", "index": 0 }]] },
    "Extract RM QTY Sheet": { "main": [[{ "node": "Bundle MPS Rows", "type": "main", "index": 0 }]] },
    "Bundle MPS Rows": { "main": [[{ "node": "Clear mps_demand Tab", "type": "main", "index": 0 }]] },
    "Clear mps_demand Tab": { "main": [[{ "node": "Expand mps_demand Rows", "type": "main", "index": 0 }]] },
    "Expand mps_demand Rows": { "main": [[{ "node": "Write mps_demand Rows", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" }
}
