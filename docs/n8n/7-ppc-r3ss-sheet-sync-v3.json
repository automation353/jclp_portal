{
  "name": "7 \u2014 PPC R3SS Sheet Sync v3",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ppc-r3ss",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wh-r3ss",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        400
      ],
      "webhookId": "ppc-r3ss"
    },
    {
      "parameters": {
        "jsCode": "// Extract tab_name and flatten rows from the webhook payload.\n// The portal sends: { report_key, tab_name, headers, rows: [...], row_count, _meta }\n// We need to output each row as a separate n8n item so Google Sheets writes one row per item.\n\nconst body = $input.first().json.body || $input.first().json;\nconst tabName = (body.tab_name || '').trim();\nconst rows    = body.rows || [];\n\nif (!tabName) {\n  throw new Error('Missing tab_name in webhook payload');\n}\n\nif (!rows.length) {\n  // No rows \u2014 just pass through tab name for clearing\n  return [{ json: { _tabName: tabName, _empty: true } }];\n}\n\n// Output each row as a separate item, carrying _tabName for the Switch\nreturn rows.map(row => ({\n  json: { ...row, _tabName: tabName }\n}));\n"
      },
      "id": "extract-rows",
      "name": "Extract Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json._tabName }}",
                    "rightValue": "PLAN",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "PLAN"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json._tabName }}",
                    "rightValue": "_MAP",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "_MAP"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json._tabName }}",
                    "rightValue": "CONTROL",
