      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "cTdqRAEN5iDJTYQk",
          "name": "Google Sheets OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Bundle PO Rows (collapse to 1 item)').first().json;\nconst rows = source.rows || [];\n\nif (!Array.isArray(rows) || rows.length === 0) {\n  throw new Error('No bundled rows available for append to PO tab.');\n}\n\nreturn rows.map(row => ({ json: row }));"
      },
