      "webhookId": "purchase-order-upload"
    },
    {
      "parameters": {
        "operation": "xlsx",
        "binaryPropertyName": "file",
        "options": {
          "headerRow": true,
          "includeEmptyCells": false,
          "sheetName": "Purchase Order Register Itemwis"
        }
      },
      "id": "po00-0000-4000-8000-000000000002",
      "name": "Extract PO Sheet",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        720,
        928
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst cleanedRows = [];\n\nfor (const item of rows) {\n  const row = item.json || {};\n\n  const hasAnyValue = Object.values(row).some(value => {\n    if (value === null || value === undefined) return false;\n    return String(value).trim() !== '';\n  });\n\n  if (!hasAnyValue) continue;\n\n  const cleanedRow = {};\n\n  for (const [key, value] of Object.entries(row)) {\n    const cleanKey = String(key || '')\n      .replace(/\\r/g, ' ')\n      .replace(/\\n/g, ' ')\n      .replace(/\\s+/g, ' ')\n      .trim();\n\n    if (!cleanKey) continue;\n    cleanedRow[cleanKey] = value;\n  }\n\n  cleanedRows.push(cleanedRow);\n}\n\nif (cleanedRows.length === 0) {\n  throw new Error('No usable data rows were extracted from the Purchase Order sheet. Check that the file has a sheet named exactly \"Purchase Order Register Itemwis\".');\n}\n\nreturn [\n  {\n    json: {\n      rowCount: cleanedRows.length,\n      rows: cleanedRows\n    }\n  }\n];"
      },
      "id": "po00-0000-4000-8000-000000000003",
      "name": "Bundle PO Rows (collapse to 1 item)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
