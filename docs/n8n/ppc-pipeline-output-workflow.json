{
  "name": "PPC Pipeline Output -> Google Sheet (BOM, Shortages, Scorecard)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ppc-pipeline-output",
        "responseMode": "onReceived",
        "responseCode": 200,
        "responseData": "={{ { \"status\": \"accepted\", \"message\": \"Pipeline output received. Writing to sheet.\" } }}",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [400, 500],
      "webhookId": "ppc-pipeline-output"
    },
    {
      "parameters": {
        "jsCode": "// Route by type: bom_explosion or scorecard\nconst input = $input.first().json;\nconst type = input.type || 'unknown';\n\nif (type === 'bom_explosion') {\n  // Extract BOM components and shortages\n  const bomRows = (input.bom_components || {}).rows || [];\n  const shortageRows = (input.shortages || {}).rows || [];\n  \n  return [{\n    json: {\n      type: 'bom_explosion',\n      plan_month: input.plan_month,\n      release_number: input.release_number,\n      bom_rows: bomRows,\n      shortage_rows: shortageRows,\n      bom_count: bomRows.length,\n      shortage_count: shortageRows.length,\n    }\n  }];\n} else if (type === 'scorecard') {\n  const sections = (input.sections || {}).rows || [];\n  \n  return [{\n    json: {\n      type: 'scorecard',\n      plan_month: input.plan_month,\n      release_number: input.release_number,\n      overall: input.overall || {},\n      section_rows: sections,\n    }\n  }];\n}\n\nthrow new Error(`Unknown pipeline output type: ${type}`);"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Route by Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 500]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "id": "cond-bom",
              "leftValue": "={{ $json.type }}",
              "rightValue": "bom_explosion",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Is BOM?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 500]
    },
    {
      "parameters": {
        "jsCode": "// Expand BOM rows for Google Sheets append\nconst data = $input.first().json;\nconst rows = data.bom_rows || [];\n\nreturn rows.map(row => ({ json: row }));"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Expand BOM Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 380]
    },
