    {
      "parameters": {
        "jsCode": "// Expand scorecard section rows\nconst data = $input.first().json;\nconst overall = data.overall || {};\nconst sections = data.section_rows || [];\n\n// First row: overall summary\nconst rows = [{\n  Section: 'OVERALL',\n  Planned: overall['Planned'] || 0,\n  Actual: overall['Actual'] || 0,\n  'Adherence %': overall['Adherence %'] || 0,\n  Backlog: overall['Backlog'] || 0,\n  Rejected: overall['Rejected'] || 0,\n  'Rejection %': overall['Rejection %'] || 0,\n}];\n\n// Section rows\nfor (const s of sections) {\n  rows.push(s);\n}\n\nreturn rows.map(r => ({ json: r }));"
      },
